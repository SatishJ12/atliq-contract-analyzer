# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud > App settings > Secrets. Never commit the real file.
# "Ask about this contract" goes to the v2 AI service on Render (it holds the Groq key).
# Both are optional: the URL defaults to https://atliq-contract-api.onrender.com, and
# without a token here the user pastes it in the app under "AI service settings".
ATLIQ_API_URL = "https://atliq-contract-api.onrender.com"
# ATLIQ_ACCESS_TOKEN = "copy from the Render service's Environment tab"
# Optional: Claude clause-by-clause review
# ANTHROPIC_API_KEY = "sk-ant-..."
